print "hello world";

fun omg(a, b) {
    if (a > b) {
        return a - b;
    }
    else {
        return a + b;
    }
}

class Car {

    init(){
    var power = false;
    var speed; var wheels = 4;
    }
    

    start() {
        print "car is starting";
        this.power = true;
        this.speed = 0;
    }

    accel() {
        if (this.power) {
            this.speed = this.speed + 10;
            print "car's speed is at ";
            print this.speed;
        }
    }

    get_speed() {
        return this.speed;
    }
}
var i = omg(4, 4);
print i;

var BMW = Car();
print BMW;
BMW.start();
print BMW.speed;
BMW.accel();

BMW.hi = "";
fun hi2() {
    print "hi2";
}
BMW.hi2 = hi2;
BMW.hi2();

